{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "lib": ["dom", "esnext"],
    "types": ["node"],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": ["index.ts", "src", "e2e", "e2e-pwa", "e2e-renders", "perf", "app.config.ts", "playwright.renders.config.ts"],
  "exclude": ["dist", "node_modules"]
}

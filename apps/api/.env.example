# Copy to .env (Bun loads it automatically). Values match docker-compose.yml's local database; no real secrets here.
DATABASE_URL=postgres://postgres:splito@localhost:55432/splito
# development or test enables the x-splito-dev-account header. Anything else (or unset) rejects every sync request.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
# Admin connection for `bun test`; each run creates and drops its own database.
TEST_DATABASE_URL=postgres://postgres:splito@localhost:55432/postgres
